# strategy-dashboard — деплой на сервер n (отдельный контейнер).
# Запускает сервер + планировщик статей через tsx. Картинки — FLUX (Fireworks),
# конвертация в webp через cwebp; agy/Gemini не нужны (гео-блок).
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl webp ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .

ENV NODE_ENV=production
EXPOSE 3000
# tsx (без watch) — запускает entrypoint c планировщиком статей
CMD ["npx", "tsx", "server/_core/index.ts"]
