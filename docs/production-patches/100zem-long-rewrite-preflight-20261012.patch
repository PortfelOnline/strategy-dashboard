+export function getRewriteDeferralReason(originalWords: number): string | null {
+  // The full rewrite prompt includes only the first 5000 characters of the source.
+  // Preserve long originals for a separate delta-edit workflow instead of paying
+  // for a replacement that the final non-truncation gate must reject.
+  const maxRewriteWords = 4000;
+  return originalWords > maxRewriteWords
+    ? `original_word_count=${originalWords} exceeds_full_rewrite_limit=${maxRewriteWords}`
+    : null;
 }
 
