+export function selectSerpSnippetFallback(
+  results: { domain: string; title: string; snippet: string }[],
+  ourDomain: string,
+): string {
+  return results
+    .filter(r => r.snippet && (!ourDomain || !r.domain.includes(ourDomain)))
+    .slice(0, 5)
+    .map(r => `- ${r.title}: ${r.snippet}`)
+    .join('\n');
+}
