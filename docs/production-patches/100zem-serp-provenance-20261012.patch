+import { describe, expect, it } from 'vitest';
+import { readFileSync } from 'fs';
+import { join } from 'path';
+import { selectSerpSnippetFallback } from './serpSnippets';
+
+const rows = [
+  { domain: 'other.ru', title: 'Как заказать', snippet: 'Пошаговая инструкция' },
+  { domain: '100zem.ru', title: 'Наш материал', snippet: 'Наш текст' },
+];
+
+describe('SERP snippet fallback', () => {
+  it('keeps competitor snippets when own domain is unknown', () => {
+    expect(selectSerpSnippetFallback(rows, '')).toContain('Пошаговая инструкция');
+  });
+  it('excludes own domain while retaining competitors', () => {
+    const text = selectSerpSnippetFallback(rows, '100zem.ru');
+    expect(text).toContain('Пошаговая инструкция');
+    expect(text).not.toContain('Наш текст');
+  });
+  it('is wired into both article rewrite paths and invalidates old mislabeled Google cache', () => {
+    const source = readFileSync(join(__dirname, '../routers/articles.ts'), 'utf8');
+    expect(source).toContain('selectSerpSnippetFallback(mergedSerp, ourDomain)');
+    expect(source).toContain('selectSerpSnippetFallback(mergedSerpResults, ourDomain)');
+    expect(source).toContain('google-searx-v2:');
+  });
+});
